// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                     @id @default(autoincrement())
  name               String
  email              String                  @unique
  password           String
  role               Role                    @default(USER)
  isVerified         Boolean                 @default(false)
  verificationCode   String?
  picture            String?
  height             Int?
  weight             Int?
  age                Int?
  goal               GoalType?
  stravaId           Int?                    @unique
  stravaAccessToken  String?
  stravaRefreshToken String?
  stravaTokenExpires DateTime?
  isSetupComplete    Boolean                 @default(false)
  verificationToken  String?                 @unique
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  Activity           Activity[]
  WorkoutPlan        WorkoutPlan[]
  WorkoutCompletion  WorkoutPlanCompletion[]
  TrackedExercise    TrackedExercise[]
  Exercise           Exercise[]
}

enum Role {
  USER
  PREMIUM
  ADMIN
}

enum GoalType {
  LOSE_WEIGHT
  GAIN_MUSCLE
  STAY_ACTIVE
}

enum ExerciseType {
  REPS
  TIME
}

enum PlanStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Otp {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  createdAt DateTime @default(now())
}

model Activity {
  id                 Int      @id @default(autoincrement())
  user               User     @relation(fields: [userId], references: [id])
  userId             Int
  stravaId           String   @unique
  name               String
  distance           Float?
  duration           Int?
  type               String?
  startDate          DateTime
  polyline           String?
  calories           Int?
  averageSpeed       Float?
  maxSpeed           Float?
  totalElevationGain Float?
  averageHeartrate   Float?
  createdAt          DateTime @default(now())
}

model ExerciseCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  exercises Exercise[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model TrackedExercise {
  id            Int          @id @default(autoincrement())
  userId        Int
  user          User         @relation(fields: [userId], references: [id])
  exerciseId    Int
  exercise      Exercise     @relation(fields: [exerciseId], references: [id])
  type          String // "reps" or "time"
  value         Int //секунди або повторення
  targetValue   Int
  completed     Boolean      @default(false)
  pauseCount    Int          @default(0)
  resetCount    Int          @default(0)
  completedAt   DateTime     @default(now())
  WorkoutPlan   WorkoutPlan? @relation(fields: [workoutPlanId], references: [id])
  workoutPlanId Int?
}

model Exercise {
  id                 Int                     @id @default(autoincrement())
  name               String                  @unique
  muscleGroup        String
  exerciseCategory   ExerciseCategory?       @relation(fields: [exerciseCategoryId], references: [id])
  exerciseCategoryId Int?
  difficulty         String?
  videoUrl           String?
  description        String?
  equipment          String?
  duration           Int?
  reps               Int?
  restDuration       Int?
  calories           Int?
  intensity          String?
  imageUrl           String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  workoutPlans       WorkoutPlanExercise[]
  completions        WorkoutPlanCompletion[]
  TrackedExercise    TrackedExercise[]
  userId             Int
  user               User                    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([exerciseCategoryId])
}

model WorkoutPlan {
  id               Int                     @id @default(autoincrement())
  userId           Int
  user             User                    @relation(fields: [userId], references: [id])
  name             String
  description      String?
  fitnessGoal      GoalType?
  status           PlanStatus              @default(IN_PROGRESS)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  exercises        WorkoutPlanExercise[]
  completions      WorkoutPlanCompletion[]
  schedules        WorkoutPlanSchedule[]
  trackedExercises TrackedExercise[]
}

model WorkoutPlanExercise {
  id            Int         @id @default(autoincrement())
  workoutPlanId Int
  exerciseId    Int
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id])
  exercise      Exercise    @relation(fields: [exerciseId], references: [id])
  order         Int
  reps          Int?        @default(0)
  duration      Int?        @default(0)
  restDuration  Int?        @default(0)
}

model WorkoutPlanCompletion {
  id            Int         @id @default(autoincrement())
  workoutPlanId Int
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id])
  userId        Int
  user          User        @relation(fields: [userId], references: [id])
  completedAt   DateTime    @default(now())
  Exercise      Exercise?   @relation(fields: [exerciseId], references: [id])
  exerciseId    Int?
}

model WorkoutPlanSchedule {
  id            Int         @id @default(autoincrement())
  workoutPlanId Int
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id])
  date          DateTime
}
