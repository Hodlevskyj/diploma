// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int                     @id @default(autoincrement())
  name               String
  email              String                  @unique
  password           String
  role               Role                    @default(USER)
  isVerified         Boolean                 @default(false)
  verificationCode   String?
  picture            String?
  height             Int?
  weight             Int?
  age                Int?
  goal               GoalType?
  stravaId           Int?                    @unique
  stravaAccessToken  String?
  stravaRefreshToken String?
  stravaTokenExpires DateTime?
  isSetupComplete    Boolean                 @default(false)
  verificationToken  String?                 @unique
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  Activity           Activity[]
  WorkoutPlan        WorkoutPlan[]
  WorkoutCompletion  WorkoutPlanCompletion[]
  TrackedExercise    TrackedExercise[]
  Exercise           Exercise[]
  FavoriteExercise   FavoriteExercise[]
  FavoritePlan       FavoritePlan[]
}

enum Role {
  USER
  PREMIUM
  ADMIN
}

enum GoalType {
  LOSE_WEIGHT
  GAIN_MUSCLE
  STAY_ACTIVE
}

model WorkoutDay {
  id            Int                   @id @default(autoincrement())
  workoutPlanId Int
  dayNumber     Int
  name          String?
  scheduledDate DateTime?
  isCompleted   Boolean               @default(false)
  completedAt   DateTime?
  workoutPlan   WorkoutPlan           @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  exercises     WorkoutPlanExercise[]

  @@index([workoutPlanId])
}

model WorkoutPlanExercise {
  id            Int         @id @default(autoincrement())
  workoutPlanId Int
  workoutDayId  Int
  exerciseId    Int
  order         Int
  reps          Int?
  duration      Int?
  restDuration  Int?
  videoUrl      String?
  isCompleted   Boolean     @default(false)
  completedAt   DateTime?
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  workoutDay    WorkoutDay  @relation(fields: [workoutDayId], references: [id], onDelete: Cascade)
  exercise      Exercise    @relation(fields: [exerciseId], references: [id])

  @@index([workoutPlanId])
  @@index([workoutDayId])
  @@index([exerciseId])
}

model WorkoutPlan {
  id                    Int                     @id @default(autoincrement())
  userId                Int
  name                  String
  description           String?
  fitnessGoal           String?
  status                String                  @default("IN_PROGRESS")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  startDate             DateTime?
  difficultyLevel       String?
  equipmentType         String?
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  WorkoutDay            WorkoutDay[]
  exercises             WorkoutPlanExercise[]
  TrackedExercise       TrackedExercise[]
  WorkoutPlanCompletion WorkoutPlanCompletion[]
  FavoritePlan          FavoritePlan[]

  @@index([userId])
}

enum ExerciseType {
  REPS
  TIME
}

enum PlanStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Otp {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  createdAt DateTime @default(now())
}

model Activity {
  id                 Int      @id @default(autoincrement())
  user               User     @relation(fields: [userId], references: [id])
  userId             Int
  stravaId           String   @unique
  name               String
  distance           Float?
  duration           Int?
  type               String?
  startDate          DateTime
  polyline           String?
  calories           Int?
  averageSpeed       Float?
  maxSpeed           Float?
  totalElevationGain Float?
  averageHeartrate   Float?
  createdAt          DateTime @default(now())
}

model ExerciseCategory {
  id        Int        @id @default(autoincrement())
  name      String     @unique
  exercises Exercise[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model TrackedExercise {
  id            Int          @id @default(autoincrement())
  userId        Int
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseId    Int
  exercise      Exercise     @relation(fields: [exerciseId], references: [id])
  type          String
  value         Int
  targetValue   Int
  completed     Boolean      @default(false)
  pauseCount    Int          @default(0)
  resetCount    Int          @default(0)
  completedAt   DateTime     @default(now())
  WorkoutPlan   WorkoutPlan? @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  workoutPlanId Int?
}

model Exercise {
  id                 Int                     @id @default(autoincrement())
  name               String                  @unique
  muscleGroup        String
  exerciseCategory   ExerciseCategory?       @relation(fields: [exerciseCategoryId], references: [id])
  exerciseCategoryId Int?
  difficulty         String?
  videoUrl           String?
  description        String?
  equipment          String?
  duration           Int?
  reps               Int?
  restDuration       Int?
  calories           Int?
  intensity          String?
  imageUrl           String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  workoutPlans       WorkoutPlanExercise[]
  completions        WorkoutPlanCompletion[]
  TrackedExercise    TrackedExercise[]
  userId             Int
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  FavoriteExercise   FavoriteExercise[]

  @@index([userId])
  @@index([exerciseCategoryId])
}

model WorkoutPlanCompletion {
  id            Int         @id @default(autoincrement())
  workoutPlanId Int
  workoutPlan   WorkoutPlan @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade)
  userId        Int
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedAt   DateTime    @default(now())
  Exercise      Exercise?   @relation(fields: [exerciseId], references: [id])
  exerciseId    Int?
}

model FavoriteExercise {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     Int
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  exerciseId Int
  createdAt  DateTime @default(now())

  @@unique([userId, exerciseId])
}

model FavoritePlan {
  id        Int      @id @default(autoincrement())
  userId    Int
  planId    Int
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([userId, planId])
  @@map("favorite_plans")
}
